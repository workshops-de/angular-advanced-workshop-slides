{
  "permissions": {
    "allow": [
      "mcp__plugin_google-slides-mcp_google-slides__*"
    ]
  },
  "enabledPlugins": {
    "google-slides-mcp@matteoantoci-plugins": true,
    "nx@nx-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    }
  },
  "sandbox": {
    "filesystem": {
      "allowRead": [
        "/tmp/.nx",
        "~/.nx"
      ],
      "allowWrite": [
        "/tmp/.nx",
        "~/.nx"
      ]
    },
    "network": {
      "allowUnixSockets": [
        "/tmp/.nx",
        "~/.nx"
      ]
    }
  }
}
